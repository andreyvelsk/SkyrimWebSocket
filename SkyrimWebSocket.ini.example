[Server]
; Address the WebSocket server binds to.
;
; Leave empty (default) to bind to 127.0.0.1 plus every automatically
; detected IPv4 address of the local network interfaces. This lets devices
; on the local subnets connect while keeping 0.0.0.0 (all interfaces) off.
;
; Set a single explicit address to override this behaviour, e.g.:
;   ListenAddress=127.0.0.1  — localhost only
;   ListenAddress=0.0.0.0    — any network interface
ListenAddress=

; TCP port the WebSocket server listens on.
; Default: 8765
Port=8765

[Debug]
; Log verbosity level. By default no log file is written.
;
; Possible values:
;   off   — no logging (default, recommended for normal use)
;   info  — server start/stop, client connect/disconnect, command results
;   debug — all of the above + every received message, subscription details,
;           equip/unequip parameters
;   trace — maximum verbosity, including every subscription poll cycle
;
; When any level other than "off" is set, the plugin also installs a crash
; handler that flushes the log and writes a minidump (.dmp) next to the
; log file when Skyrim crashes.
;
; Log file location:
;   %USERPROFILE%\Documents\My Games\Skyrim Special Edition\SKSE\SkyrimWebSocket.log
;
; To report a bug or crash, set LogLevel=debug, reproduce the problem,
; then send both the .log and .dmp files.
LogLevel=off
